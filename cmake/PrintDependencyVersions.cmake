function(read_version_macro path macro output)
    set(_value "")
    if(EXISTS "${path}")
        file(STRINGS "${path}" _line REGEX "^#[ \t]*define[ \t]+${macro}[ \t]+")
        if(_line MATCHES "^#[ \t]*define[ \t]+${macro}[ \t]+\"?([^\" \t\r\n]+)")
            set(_value "${CMAKE_MATCH_1}")
        endif()
    endif()
    set(${output} "${_value}" PARENT_SCOPE)
endfunction()

function(read_triplet path prefix output)
    set(_suffix "${ARGV3}")
    foreach(_part IN ITEMS MAJOR MINOR PATCH)
        read_version_macro("${path}" "${prefix}_${_part}${_suffix}" _${_part})
    endforeach()
    if(_MAJOR MATCHES "^[0-9]+$" AND _MINOR MATCHES "^[0-9]+$" AND _PATCH MATCHES "^[0-9]+$")
        set(${output} "${_MAJOR}.${_MINOR}.${_PATCH}" PARENT_SCOPE)
    else()
        set(${output} "unknown (version header unavailable)" PARENT_SCOPE)
    endif()
endfunction()

function(report_version name value)
    if("${value}" STREQUAL "")
        set(value "unknown (version metadata unavailable)")
    endif()
    message(STATUS "  ${name}: ${value}")
endfunction()

function(submodule_revision path output)
    set(_revision "revision unavailable")
    if(REPORT_GIT_EXECUTABLE AND EXISTS "${path}/.git")
        execute_process(COMMAND "${REPORT_GIT_EXECUTABLE}" -C "${path}" describe --tags --always --dirty
            RESULT_VARIABLE _result OUTPUT_VARIABLE _description ERROR_QUIET
            OUTPUT_STRIP_TRAILING_WHITESPACE TIMEOUT 5)
        if(_result STREQUAL "0" AND NOT _description STREQUAL "")
            set(_revision "${_description}")
        endif()
    endif()
    set(${output} "${_revision}" PARENT_SCOPE)
endfunction()

message(STATUS "External dependency versions used by this build:")
read_triplet("${REPORT_TAGLIB_SOURCE_DIR}/taglib/toolkit/taglib.h" "TAGLIB" _taglib "_VERSION")
report_version("TagLib" "${_taglib}")

read_version_macro("${REPORT_SOURCE_DIR}/external/CLI11/include/CLI/Version.hpp" "CLI11_VERSION" _cli11)
if(_cli11 STREQUAL "")
    set(_cli11 "unknown (version header unavailable)")
endif()
submodule_revision("${REPORT_SOURCE_DIR}/external/CLI11" _cli11_revision)
report_version("CLI11 (submodule)" "${_cli11} (${_cli11_revision})")

read_triplet("${REPORT_SOURCE_DIR}/external/spdlog/include/spdlog/version.h" "SPDLOG_VER" _spdlog)
submodule_revision("${REPORT_SOURCE_DIR}/external/spdlog" _spdlog_revision)
report_version("spdlog (submodule)" "${_spdlog} (${_spdlog_revision})")

read_version_macro("${REPORT_SOURCE_DIR}/external/spdlog/include/spdlog/fmt/bundled/base.h" "FMT_VERSION" _fmt)
if(_fmt MATCHES "^[0-9]+$")
    math(EXPR _fmt_major "${_fmt} / 10000")
    math(EXPR _fmt_minor "(${_fmt} / 100) % 100")
    math(EXPR _fmt_patch "${_fmt} % 100")
    set(_fmt "${_fmt_major}.${_fmt_minor}.${_fmt_patch}")
endif()
report_version("fmt (bundled with spdlog)" "${_fmt}")

read_version_macro("${REPORT_SOURCE_DIR}/external/sqlite-amalgamation/sqlite3.h" "SQLITE_VERSION" _sqlite)
report_version("SQLite" "${_sqlite}")
read_triplet("${REPORT_SOURCE_DIR}/FlacConvert/include/rapidjson/rapidjson.h" "RAPIDJSON" _rapidjson "_VERSION")
report_version("RapidJSON" "${_rapidjson}")

read_version_macro("${REPORT_FFMPEG_INCLUDE_DIR}/libavutil/ffversion.h" "FFMPEG_VERSION" _ffmpeg)
report_version("FFmpeg headers" "${_ffmpeg}")
foreach(_component IN ITEMS avformat avcodec avfilter avutil swresample)
    string(TOUPPER "lib${_component}" _prefix)
    foreach(_part IN ITEMS MAJOR MINOR MICRO)
        read_version_macro("${REPORT_FFMPEG_INCLUDE_DIR}/lib${_component}/version.h"
            "${_prefix}_VERSION_${_part}" _${_part})
        if("${_${_part}}" STREQUAL "")
            read_version_macro("${REPORT_FFMPEG_INCLUDE_DIR}/lib${_component}/version_major.h"
                "${_prefix}_VERSION_${_part}" _${_part})
        endif()
    endforeach()
    if(_MAJOR MATCHES "^[0-9]+$" AND _MINOR MATCHES "^[0-9]+$" AND _MICRO MATCHES "^[0-9]+$")
        set(_component_version "${_MAJOR}.${_MINOR}.${_MICRO}")
    else()
        set(_component_version "unknown (version header unavailable)")
    endif()
    report_version("FFmpeg lib${_component} headers" "${_component_version}")
endforeach()
if(REPORT_FFMPEG_EXECUTABLE AND EXISTS "${REPORT_FFMPEG_EXECUTABLE}")
    execute_process(COMMAND "${REPORT_FFMPEG_EXECUTABLE}" -version RESULT_VARIABLE _ffmpeg_result
        OUTPUT_VARIABLE _ffmpeg_output ERROR_QUIET TIMEOUT 5)
    if(_ffmpeg_result STREQUAL "0")
        string(REGEX MATCH "^[^\r\n]+" _ffmpeg_tool "${_ffmpeg_output}")
    endif()
endif()
report_version("FFmpeg build tool" "${_ffmpeg_tool}")

if(REPORT_UTFCPP_FOUND)
    report_version("utfcpp (system)" "${REPORT_UTFCPP_VERSION}")
else()
    set(_utfcpp_version_file "${REPORT_TAGLIB_BINARY_DIR}/3rdparty/utfcpp/utf8cppConfigVersion.cmake")
    if(EXISTS "${_utfcpp_version_file}")
        file(STRINGS "${_utfcpp_version_file}" _utfcpp_line
            REGEX "^set\\(PACKAGE_VERSION \"[^\"]+\"\\)")
        if(_utfcpp_line MATCHES "^set\\(PACKAGE_VERSION \"([^\"]+)\"\\)")
            set(_utfcpp "${CMAKE_MATCH_1}")
        endif()
    endif()
    report_version("utfcpp (bundled with TagLib)" "${_utfcpp}")
endif()

set(_taglib_config "${REPORT_TAGLIB_BINARY_DIR}/config.h")
if(EXISTS "${_taglib_config}")
    file(STRINGS "${_taglib_config}" _have_zlib REGEX "^#[ \t]*define[ \t]+HAVE_ZLIB[ \t]+1")
    if(_have_zlib)
        read_version_macro("${REPORT_ZLIB_INCLUDE_DIR}/zlib.h" "ZLIB_VERSION" _zlib)
        report_version("ZLIB (TagLib)" "${_zlib}")
    else()
        report_version("ZLIB (TagLib)" "not enabled")
    endif()
else()
    report_version("ZLIB (TagLib)" "")
endif()
